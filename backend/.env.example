# --- Google Cloud Project Settings ---
GCP_PROJECT_ID="trust-trailblazers"
GCS_BUCKET_NAME="land-guard-docs-trust-trailblazers"
FIREBASE_PROJECT_ID="trust-trailblazers"

# --- ADK Agent Settings ---
# The service account email that agents will use for Vertex AI and other GCP services
ADK_AGENT_SERVICE_ACCOUNT="adk-agent-sa@trust-trailblazers.iam.gserviceaccount.com"

# --- Storage Settings ---
FIRESTORE_COLLECTION_DOCUMENTS="documents"
FIRESTORE_COLLECTION_ANALYSIS_REPORTS="analysis_reports"

# --- Security & Auth ---
# Optional: Set this to "true" to bypass real Firebase verification for local testing
# AUTH_BYPASS_FOR_TESTING="false"

# --- Server Settings ---
PORT=8000
LOG_LEVEL="info"
